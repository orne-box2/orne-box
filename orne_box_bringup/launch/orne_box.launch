<?xml version="1.0"?>

<launch>
  <arg name="use_camera" default="false"/>

  <include file="$(find icart_mini_driver)/launch/icart_mini_drive.launch">
    <!--arg name="model"           value="$(find xacro)/xacro '$(find orne_box_description)/urdf/orne_box.urdf.xacro'" /-->
    <arg name="model"           value="$(find xacro)/xacro --inorder '$(find orne_box_description)/urdf/orne_box_3d_lidar.urdf.xacro' use_camera:=$(arg use_camera)" />
 
    <arg name="ypspur_params"   value="$(find orne_box_setup)/config/orne_box.param" />
    <arg name="use_eth_urg"     value="true" />
    <arg name="urg_ip"          value="192.168.0.10" />
  </include>

    <include file="$(find orne_box_bringup)/launch/includes/base.launch.xml"/>

    <include file="$(find orne_box_bringup)/launch/includes/adis_rcv_csv_orne.launch"/>

    <include file="$(find orne_box_bringup)/launch/includes/rfans16.launch"/>

    <include file="$(find orne_box_bringup)/launch/includes/cost_cloud_postprocessor.launch">
      <arg name="cloud_source" default="/rfans/surestar_points"/>
      <arg name="output_frame_id" default="surestar"/>
    </include>
</launch>

